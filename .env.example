# Copy to an ignored .env. Generate distinct verifiers with prescriptxai hash-password.
# Replace both empty values. There are no default passwords.
PRESCRIPTXAI_OPERATOR_PASSWORD_HASH=
PRESCRIPTXAI_ADMIN_PASSWORD_HASH=
PSX_API_ORIGIN=https://localhost:8000
PSX_DASHBOARD_ORIGIN=https://localhost:8501
PSX_TLS_DIR=
PSX_MANIFEST=
PSX_WORKSPACE=./artifacts/demo
PSX_IMAGE=prescriptxai:local
